#!/bin/bash
# A/B launcher: control = Claude Code built-in memory only; rfm = built-in
# PLUS the mem-rfm MCP server. Both arms run with --strict-mcp-config so the
# tool environment is identical except for the memory server. Assignment is
# random per session (or forced via --arm, which is recorded as forced=true)
# and logged as JSON for ab_stats.py.
#
# Usage: ab-claude [--label "task description"] [claude args...]
set -euo pipefail
HERE="$(cd "$(dirname "$0")" && pwd)"
PY="$HERE/../.venv/bin/python"
LOG="$HERE/ab_log.jsonl"
LABEL=""
ARM=""
FORCED="false"
ARGS=()
while [ $# -gt 0 ]; do
  case "$1" in
    --label) LABEL="$2"; shift 2 ;;
    --arm) ARM="$2"; FORCED="true"; shift 2 ;;
    *) ARGS+=("$1"); shift ;;
  esac
done
if [ -z "$ARM" ]; then
  if [ $((RANDOM % 2)) -eq 0 ]; then ARM="control"; else ARM="rfm"; fi
fi

# Session marker lets ab_stats match transcripts by identity, not just time.
AB_SESSION="$(date +%s)-$$"
START=$(date +%s)
export RFM_AB_ARM="$ARM"
export RFM_AB_SESSION="$AB_SESSION"

# Contamination check: memory-tool instructions in always-on CLAUDE.md files
# load in BOTH arms, so control sessions would chase nonexistent tools (see
# capture.md). Warn loudly; don't block (substring match can false-positive).
for md in "$PWD/CLAUDE.md" "$PWD/CLAUDE.local.md" "$HOME/.claude/CLAUDE.md"; do
  if [ -f "$md" ] && grep -q -e memory_search -e memory_save "$md"; then
    echo "[ab-claude] WARNING: $md mentions memory tools — remove the capture.md snippet during A/B runs or control-arm results will be biased" >&2
  fi
done

if [ "$ARM" = "rfm" ]; then
  # Generate the MCP config from this checkout's real paths at launch —
  # a committed config with baked absolute paths breaks every other clone.
  CFG="$(mktemp -t mcp-rfm)"
  trap 'rm -f "$CFG"' EXIT
  "$PY" - "$PY" "$HERE/../server.py" > "$CFG" << 'EOF'
import json, sys
print(json.dumps({"mcpServers": {"rfm-memory": {
    "command": sys.argv[1], "args": [sys.argv[2]]}}}))
EOF
else
  CFG="$HERE/mcp-empty.json"
fi

echo "[ab-claude] arm=$ARM forced=$FORCED (label: ${LABEL:-none})" >&2
set +e
# ${ARGS[@]+...} guard: bare "${ARGS[@]}" on an empty array aborts under
# set -u on macOS's default bash 3.2.
claude --strict-mcp-config --mcp-config "$CFG" ${ARGS[@]+"${ARGS[@]}"}
STATUS=$?
set -e
END=$(date +%s)
# RFM_AB_ARM / RFM_AB_SESSION are already exported above.
LABEL="$LABEL" FORCED="$FORCED" \
  START="$START" END="$END" STATUS="$STATUS" "$PY" - >> "$LOG" << 'EOF'
import json, os
print(json.dumps({
    "arm": os.environ["RFM_AB_ARM"], "label": os.environ["LABEL"],
    "forced": os.environ["FORCED"] == "true",
    "ab_session": os.environ["RFM_AB_SESSION"],
    "start": int(os.environ["START"]), "end": int(os.environ["END"]),
    "exit": int(os.environ["STATUS"]), "cwd": os.getcwd(),
}))
EOF
echo "[ab-claude] session logged: arm=$ARM $((END-START))s" >&2
exit $STATUS
